{
  "name": "lipid-management",
  "version": "0.6.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "generate:sdi-2019": "tsx scripts/generate-sdi-2019.ts",
    "generate:fhir-libraries": "tsx scripts/generate-fhir-libraries.ts",
    "package:fhir": "npm run generate:fhir-libraries && COPYFILE_DISABLE=1 tar --exclude .DS_Store -czf com.prestonlee.fhir.lipid-management-$(node -p \"require('./public/package/package.json').version\").tgz -C public package",
    "extract:prevent-s12": "tsx scripts/extract-prevent-s12.ts",
    "extract:prevent-percentiles": "tsx scripts/extract-prevent-percentiles.ts",
    "validate:prevent-aha": "tsx scripts/validate-prevent-aha-goldens.ts",
    "compare:prevent-aha": "tsx scripts/compare-prevent-aha.ts"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/common": "^22.1.2",
    "@angular/compiler": "^22.1.2",
    "@angular/core": "^22.1.2",
    "@angular/forms": "^22.1.2",
    "@angular/platform-browser": "^22.1.2",
    "@angular/router": "^22.1.2",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "bootswatch": "^5.3.8",
    "fhirclient": "^2.6.3",
    "mermaid": "^11.17.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.2",
    "@types/fhir": "^0.0.44",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "<7",
    "vitest": "^4.1.11",
    "xlsx": "^0.18.5"
  }
}
