/* Base-model total CVD only (ignores optional add-on model selection). */

define PrepTerms10BaseOnly:
  case
    when not InputsComplete then null
    else PrepTerms10YrBase(EffectiveAgeYears, EffectiveTotalCholMgDl, EffectiveHdlMgDl, EffectiveSbpMmHg, EffectiveDiabetes, EffectiveCurrentSmoker, EffectiveBmiKgM2, EffectiveEgfr, EffectiveAntihypertensive, EffectiveStatin) end

define PrepTerms30BaseOnly:
  case
    when not InputsComplete then null
    else PrepTerms30YrBase(EffectiveAgeYears, EffectiveTotalCholMgDl, EffectiveHdlMgDl, EffectiveSbpMmHg, EffectiveDiabetes, EffectiveCurrentSmoker, EffectiveBmiKgM2, EffectiveEgfr, EffectiveAntihypertensive, EffectiveStatin) end

define BaseTenYearTotalCvdProbability:
  case
    when not InputsComplete then null
    when EffectiveIsMale then RiskFromBetasN(23, Beta10MaleTotalCvdBase, PrepTerms10BaseOnly)
    when EffectiveIsFemale then RiskFromBetasN(23, Beta10FemaleTotalCvdBase, PrepTerms10BaseOnly)
    else null end

define BaseTenYearTotalCvdPercent:
  case when BaseTenYearTotalCvdProbability is null then null else 100.0 * BaseTenYearTotalCvdProbability end

define BaseThirtyYearTotalCvdProbability:
  case
    when not InputsComplete then null
    when EffectiveIsMale then RiskFromBetasN(24, Beta30MaleTotalCvdBase, PrepTerms30BaseOnly)
    when EffectiveIsFemale then RiskFromBetasN(24, Beta30FemaleTotalCvdBase, PrepTerms30BaseOnly)
    else null end

define BaseThirtyYearTotalCvdPercent:
  case when BaseThirtyYearTotalCvdProbability is null then null else 100.0 * BaseThirtyYearTotalCvdProbability end

/* OpenCVDRisk Age: Krishnan JAMA Cardiology 2025; p-hat = base 10y total CVD percent. */

define OpenCvdRiskAge:
  case
    when BaseTenYearTotalCvdPercent is null then null
    when BaseTenYearTotalCvdPercent <= 0.0 then null
    when EffectiveIsFemale then Round(Min({ 79.0, Max({ 30.0, 45.09746 + 11.27498 * Ln(BaseTenYearTotalCvdPercent) }) }))
    when EffectiveIsMale then Round(Min({ 79.0, Max({ 30.0, 41.55092 + 11.72711 * Ln(BaseTenYearTotalCvdPercent) }) }))
    else null end

/* Aliases retained for PrepTerms* chart consumers */
define PrepTerms10:
  PrepTerms10Selected

define PrepTerms30:
  PrepTerms30Selected

/* --- PREVENT applicability (advisory; does not change risk math) --- */

define function QuantityAsPercent(q FHIR.Quantity):
  case
    when q is null then null
    when q.unit ~ '%' or q.code ~ '%' then q.value
    when q.value is not null and q.value <= 1.0 then q.value * 100.0
    else q.value end

define PreventExclusionAgeOutOfRange:
  EffectiveAgeYears < 30 or EffectiveAgeYears > 79

define ActiveKnownCvdCondition:
  First([Condition: "AtheroscleroticCardiovascularDisease"] C
      where exists ( C.clinicalStatus.coding CSCode where CSCode.code ~ 'active' ))

define PreventExclusionKnownCvd:
  ActiveKnownCvdCondition is not null

define LatestLvefObservation:
  First([Observation: "LeftVentricularEjectionFraction"] O
      where O.status in { 'final', 'amended', 'corrected' } and O.effective is not null and O.value is FHIR.Quantity
      sort by start of effective desc)

define LatestLvefPercent:
  case when LatestLvefObservation is null then null else QuantityAsPercent(LatestLvefObservation.value as FHIR.Quantity) end

define PreventExclusionLvefBelow40:
  LatestLvefPercent is not null and LatestLvefPercent < 40.0

define ActiveHfrEfCondition:
  First([Condition: "HeartFailureWithReducedEjectionFraction"] C
      where exists ( C.clinicalStatus.coding CSCode where CSCode.code ~ 'active' ))

define PreventExclusionHfref:
  ActiveHfrEfCondition is not null

define PreventExclusionSevereLvSystolicDysfunction:
  PreventExclusionLvefBelow40 or PreventExclusionHfref

define LatestCacObservation:
  First([Observation: "CoronaryArteryCalciumScore"] O
      where O.status in { 'final', 'amended', 'corrected' } and O.effective is not null and O.value is FHIR.Quantity
      sort by start of effective desc)

define LatestCacScore:
  case when LatestCacObservation is null then null else FHIRHelpers.ToQuantity ( LatestCacObservation.value as FHIR.Quantity ).value end

define PreventExclusionCacAtLeast300:
  LatestCacScore is not null and LatestCacScore >= 300.0

define ActiveEskdCondition:
  First([Condition: "EndStageKidneyDisease"] C
      where exists ( C.clinicalStatus.coding CSCode where CSCode.code ~ 'active' ))

define PreventExclusionEskd:
  ActiveEskdCondition is not null

define ActiveInheritedCvdCondition:
  First([Condition: "InheritedCardiovascularCondition"] C
      where exists ( C.clinicalStatus.coding CSCode where CSCode.code ~ 'active' ))

define PreventExclusionInheritedCvdCondition:
  ActiveInheritedCvdCondition is not null

define PreventExclusionLifeExpectancyLimited:
  LifeExpectancyLimited

define PreventExclusionPathogenicGeneticVariant:
  PathogenicGeneticCvdVariant

define PreventHasAnyExclusion:
  PreventExclusionAgeOutOfRange
    or PreventExclusionKnownCvd
    or PreventExclusionSevereLvSystolicDysfunction
    or PreventExclusionCacAtLeast300
    or PreventExclusionEskd
    or PreventExclusionInheritedCvdCondition
    or PreventExclusionLifeExpectancyLimited
    or PreventExclusionPathogenicGeneticVariant

define PreventExclusionReasons:
  flatten ( {
      if PreventExclusionAgeOutOfRange then { 'Age outside 30–79 years' } else { },
      if PreventExclusionKnownCvd then { 'Chart suggests known atherosclerotic cardiovascular disease' } else { },
      if PreventExclusionLvefBelow40 then { 'Left ventricular ejection fraction <40%' } else { },
      if PreventExclusionHfref and not PreventExclusionLvefBelow40 then { 'Chart suggests heart failure with reduced ejection fraction' } else { },
      if PreventExclusionCacAtLeast300 then { 'Coronary artery calcium score ≥300' } else { },
      if PreventExclusionEskd then { 'Chart suggests end-stage kidney disease' } else { },
      if PreventExclusionInheritedCvdCondition then { 'Chart suggests inherited cardiovascular condition' } else { },
      if PreventExclusionLifeExpectancyLimited then { 'Limited life expectancy (<1 year)' } else { },
      if PreventExclusionPathogenicGeneticVariant then { 'Known pathogenic genetic CVD variant' } else { }
  } )
