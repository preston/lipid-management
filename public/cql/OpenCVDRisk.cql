define function PrepAgeTen(ageYears System.Integer):
  ( ageYears - 55 ) / 10.0

define function PrepNonHdlMmol(totalCholMgDl System.Decimal, hdlMgDl System.Decimal):
  ( ( totalCholMgDl - hdlMgDl ) * 0.02586 ) - 3.5

define function PrepHdlScaled(hdlMgDl System.Decimal):
  ( ( hdlMgDl * 0.02586 ) - 1.3 ) / 0.3

define function SplineSbpLt(sbpMmHg System.Decimal):
  ( ( if sbpMmHg < 110.0 then sbpMmHg else 110.0 ) - 110.0 ) / 20.0

define function SplineSbpGte(sbpMmHg System.Decimal):
  ( ( if sbpMmHg > 110.0 then sbpMmHg else 110.0 ) - 130.0 ) / 20.0

define function SplineBmiLt(bmiKgM2 System.Decimal):
  ( ( if bmiKgM2 < 30.0 then bmiKgM2 else 30.0 ) - 25.0 ) / 5.0

define function SplineBmiGte(bmiKgM2 System.Decimal):
  ( ( if bmiKgM2 > 30.0 then bmiKgM2 else 30.0 ) - 30.0 ) / 5.0

define function SplineEgfrLt(egfr System.Decimal):
  ( ( if egfr < 60.0 then egfr else 60.0 ) - 60.0 ) / - 15.0

define function SplineEgfrGte(egfr System.Decimal):
  ( ( if egfr > 60.0 then egfr else 60.0 ) - 90.0 ) / - 15.0

define function BoolAsDecimal(b System.Boolean):
  if b then 1.0 else 0.0

define function PrepCore10(ageYears System.Integer, totalCholMgDl System.Decimal, hdlMgDl System.Decimal, sbpMmHg System.Decimal, dm System.Boolean, smoking System.Boolean, bmiKgM2 System.Decimal, egfr System.Decimal, bpTx System.Boolean, statin System.Boolean):
  List < System.Decimal > { PrepAgeTen(ageYears), PrepNonHdlMmol(totalCholMgDl, hdlMgDl), PrepHdlScaled(hdlMgDl), SplineSbpLt(sbpMmHg), SplineSbpGte(sbpMmHg), BoolAsDecimal(dm), BoolAsDecimal(smoking), SplineBmiLt(bmiKgM2), SplineBmiGte(bmiKgM2), SplineEgfrLt(egfr), SplineEgfrGte(egfr), BoolAsDecimal(bpTx), BoolAsDecimal(statin), BoolAsDecimal(bpTx) * SplineSbpGte(sbpMmHg), BoolAsDecimal(statin) * PrepNonHdlMmol(totalCholMgDl, hdlMgDl), PrepAgeTen(ageYears) * PrepNonHdlMmol(totalCholMgDl, hdlMgDl), PrepAgeTen(ageYears) * PrepHdlScaled(hdlMgDl), PrepAgeTen(ageYears) * SplineSbpGte(sbpMmHg), PrepAgeTen(ageYears) * BoolAsDecimal(dm), PrepAgeTen(ageYears) * BoolAsDecimal(smoking), PrepAgeTen(ageYears) * SplineBmiGte(bmiKgM2), PrepAgeTen(ageYears) * SplineEgfrLt(egfr) }

define function PrepCore30(ageYears System.Integer, totalCholMgDl System.Decimal, hdlMgDl System.Decimal, sbpMmHg System.Decimal, dm System.Boolean, smoking System.Boolean, bmiKgM2 System.Decimal, egfr System.Decimal, bpTx System.Boolean, statin System.Boolean):
  List < System.Decimal > { PrepAgeTen(ageYears), PrepAgeTen(ageYears) * PrepAgeTen(ageYears), PrepNonHdlMmol(totalCholMgDl, hdlMgDl), PrepHdlScaled(hdlMgDl), SplineSbpLt(sbpMmHg), SplineSbpGte(sbpMmHg), BoolAsDecimal(dm), BoolAsDecimal(smoking), SplineBmiLt(bmiKgM2), SplineBmiGte(bmiKgM2), SplineEgfrLt(egfr), SplineEgfrGte(egfr), BoolAsDecimal(bpTx), BoolAsDecimal(statin), BoolAsDecimal(bpTx) * SplineSbpGte(sbpMmHg), BoolAsDecimal(statin) * PrepNonHdlMmol(totalCholMgDl, hdlMgDl), PrepAgeTen(ageYears) * PrepNonHdlMmol(totalCholMgDl, hdlMgDl), PrepAgeTen(ageYears) * PrepHdlScaled(hdlMgDl), PrepAgeTen(ageYears) * SplineSbpGte(sbpMmHg), PrepAgeTen(ageYears) * BoolAsDecimal(dm), PrepAgeTen(ageYears) * BoolAsDecimal(smoking), PrepAgeTen(ageYears) * SplineBmiGte(bmiKgM2), PrepAgeTen(ageYears) * SplineEgfrLt(egfr) }

define function PrepTerms10YrBase(ageYears System.Integer, totalCholMgDl System.Decimal, hdlMgDl System.Decimal, sbpMmHg System.Decimal, dm System.Boolean, smoking System.Boolean, bmiKgM2 System.Decimal, egfr System.Decimal, bpTx System.Boolean, statin System.Boolean):
  flatten({ PrepCore10(ageYears, totalCholMgDl, hdlMgDl, sbpMmHg, dm, smoking, bmiKgM2, egfr, bpTx, statin), { 1.0 } })

define function PrepTerms30YrBase(ageYears System.Integer, totalCholMgDl System.Decimal, hdlMgDl System.Decimal, sbpMmHg System.Decimal, dm System.Boolean, smoking System.Boolean, bmiKgM2 System.Decimal, egfr System.Decimal, bpTx System.Boolean, statin System.Boolean):
  flatten({ PrepCore30(ageYears, totalCholMgDl, hdlMgDl, sbpMmHg, dm, smoking, bmiKgM2, egfr, bpTx, statin), { 1.0 } })

/* Enhanced prep: core + novel + missing slots + constant. Optional values must be valid when used on single models. */

define function PrepTerms10Uacr(ageYears System.Integer, totalCholMgDl System.Decimal, hdlMgDl System.Decimal, sbpMmHg System.Decimal, dm System.Boolean, smoking System.Boolean, bmiKgM2 System.Decimal, egfr System.Decimal, bpTx System.Boolean, statin System.Boolean, uacr System.Decimal):
  flatten({ PrepCore10(ageYears, totalCholMgDl, hdlMgDl, sbpMmHg, dm, smoking, bmiKgM2, egfr, bpTx, statin), { Ln(uacr), 0.0, 1.0 } })

define function PrepTerms10Hba1c(ageYears System.Integer, totalCholMgDl System.Decimal, hdlMgDl System.Decimal, sbpMmHg System.Decimal, dm System.Boolean, smoking System.Boolean, bmiKgM2 System.Decimal, egfr System.Decimal, bpTx System.Boolean, statin System.Boolean, hba1c System.Decimal):
  flatten({ PrepCore10(ageYears, totalCholMgDl, hdlMgDl, sbpMmHg, dm, smoking, bmiKgM2, egfr, bpTx, statin), { ( hba1c - 5.3 ) * BoolAsDecimal(dm), ( hba1c - 5.3 ) * ( 1.0 - BoolAsDecimal(dm) ), 0.0, 1.0 } })

define function PrepTerms10Sdi(ageYears System.Integer, totalCholMgDl System.Decimal, hdlMgDl System.Decimal, sbpMmHg System.Decimal, dm System.Boolean, smoking System.Boolean, bmiKgM2 System.Decimal, egfr System.Decimal, bpTx System.Boolean, statin System.Boolean, sdi System.Integer):
  flatten({ PrepCore10(ageYears, totalCholMgDl, hdlMgDl, sbpMmHg, dm, smoking, bmiKgM2, egfr, bpTx, statin), { if sdi >= 4 and sdi <= 6 then 1.0 else 0.0, if sdi >= 7 then 1.0 else 0.0, 0.0, 1.0 } })

define function PrepTerms10Full(ageYears System.Integer, totalCholMgDl System.Decimal, hdlMgDl System.Decimal, sbpMmHg System.Decimal, dm System.Boolean, smoking System.Boolean, bmiKgM2 System.Decimal, egfr System.Decimal, bpTx System.Boolean, statin System.Boolean, uacr System.Decimal, hasUacr System.Boolean, hba1c System.Decimal, hasHba1c System.Boolean, sdi System.Integer, hasSdi System.Boolean):
  flatten({ PrepCore10(ageYears, totalCholMgDl, hdlMgDl, sbpMmHg, dm, smoking, bmiKgM2, egfr, bpTx, statin), {
    if hasSdi and sdi >= 4 and sdi <= 6 then 1.0 else 0.0,
    if hasSdi and sdi >= 7 then 1.0 else 0.0,
    if hasSdi then 0.0 else 1.0,
    if hasUacr then Ln(uacr) else 0.0,
    if hasUacr then 0.0 else 1.0,
    if hasHba1c then ( hba1c - 5.3 ) * BoolAsDecimal(dm) else 0.0,
    if hasHba1c then ( hba1c - 5.3 ) * ( 1.0 - BoolAsDecimal(dm) ) else 0.0,
    if hasHba1c then 0.0 else 1.0,
    1.0
  } })

define function PrepTerms30Uacr(ageYears System.Integer, totalCholMgDl System.Decimal, hdlMgDl System.Decimal, sbpMmHg System.Decimal, dm System.Boolean, smoking System.Boolean, bmiKgM2 System.Decimal, egfr System.Decimal, bpTx System.Boolean, statin System.Boolean, uacr System.Decimal):
  flatten({ PrepCore30(ageYears, totalCholMgDl, hdlMgDl, sbpMmHg, dm, smoking, bmiKgM2, egfr, bpTx, statin), { Ln(uacr), 0.0, 1.0 } })

define function PrepTerms30Hba1c(ageYears System.Integer, totalCholMgDl System.Decimal, hdlMgDl System.Decimal, sbpMmHg System.Decimal, dm System.Boolean, smoking System.Boolean, bmiKgM2 System.Decimal, egfr System.Decimal, bpTx System.Boolean, statin System.Boolean, hba1c System.Decimal):
  flatten({ PrepCore30(ageYears, totalCholMgDl, hdlMgDl, sbpMmHg, dm, smoking, bmiKgM2, egfr, bpTx, statin), { ( hba1c - 5.3 ) * BoolAsDecimal(dm), ( hba1c - 5.3 ) * ( 1.0 - BoolAsDecimal(dm) ), 0.0, 1.0 } })

define function PrepTerms30Sdi(ageYears System.Integer, totalCholMgDl System.Decimal, hdlMgDl System.Decimal, sbpMmHg System.Decimal, dm System.Boolean, smoking System.Boolean, bmiKgM2 System.Decimal, egfr System.Decimal, bpTx System.Boolean, statin System.Boolean, sdi System.Integer):
  flatten({ PrepCore30(ageYears, totalCholMgDl, hdlMgDl, sbpMmHg, dm, smoking, bmiKgM2, egfr, bpTx, statin), { if sdi >= 4 and sdi <= 6 then 1.0 else 0.0, if sdi >= 7 then 1.0 else 0.0, 0.0, 1.0 } })

define function PrepTerms30Full(ageYears System.Integer, totalCholMgDl System.Decimal, hdlMgDl System.Decimal, sbpMmHg System.Decimal, dm System.Boolean, smoking System.Boolean, bmiKgM2 System.Decimal, egfr System.Decimal, bpTx System.Boolean, statin System.Boolean, uacr System.Decimal, hasUacr System.Boolean, hba1c System.Decimal, hasHba1c System.Boolean, sdi System.Integer, hasSdi System.Boolean):
  flatten({ PrepCore30(ageYears, totalCholMgDl, hdlMgDl, sbpMmHg, dm, smoking, bmiKgM2, egfr, bpTx, statin), {
    if hasSdi and sdi >= 4 and sdi <= 6 then 1.0 else 0.0,
    if hasSdi and sdi >= 7 then 1.0 else 0.0,
    if hasSdi then 0.0 else 1.0,
    if hasUacr then Ln(uacr) else 0.0,
    if hasUacr then 0.0 else 1.0,
    if hasHba1c then ( hba1c - 5.3 ) * BoolAsDecimal(dm) else 0.0,
    if hasHba1c then ( hba1c - 5.3 ) * ( 1.0 - BoolAsDecimal(dm) ) else 0.0,
    if hasHba1c then 0.0 else 1.0,
    1.0
  } })

define function RiskFromBetasN(n System.Integer, betas List<System.Decimal>, terms List<System.Decimal>):
  case
    when terms is null then null
    when n = 23 then Sigmoid(DotProduct23(betas, terms))
    when n = 24 then Sigmoid(DotProduct24(betas, terms))
    when n = 25 then Sigmoid(DotProduct25(betas, terms))
    when n = 26 then Sigmoid(DotProduct26(betas, terms))
    when n = 27 then Sigmoid(DotProduct27(betas, terms))
    when n = 31 then Sigmoid(DotProduct31(betas, terms))
    when n = 32 then Sigmoid(DotProduct32(betas, terms))
    else null end

define function Egfr2021Base(scrMgDl System.Decimal, ageYears System.Integer, k System.Decimal, alpha System.Decimal):
  142.0 * Power((if scrMgDl / k <= 1.0 then scrMgDl / k else 1.0), alpha) * Power((if scrMgDl / k >= 1.0 then scrMgDl / k else 1.0), - 1.2) * Power(0.9938, ageYears)

define function Egfr2021Creatinine(scrMgDl System.Decimal, ageYears System.Integer, female System.Boolean):
  if female then Egfr2021Base(scrMgDl, ageYears, 0.7, - 0.241) * 1.012 else Egfr2021Base(scrMgDl, ageYears, 0.9, - 0.302)

define function ObservationQuantityToMgDl(q FHIR.Quantity):
  ( convert FHIRHelpers.ToQuantity ( q ) to 'mg/dL' ).value


define LatestTotalCholObservation:
  First([Observation: "TotalCholesterol"] O
      where O.status in { 'final', 'amended', 'corrected' } and O.value is FHIR.Quantity and O.effective is not null
      sort by start of effective desc)

define LatestHdlObservation:
  First([Observation: "HdlCholesterol"] O
      where O.status in { 'final', 'amended', 'corrected' } and O.value is FHIR.Quantity and O.effective is not null
      sort by start of effective desc)

define LatestLdlObservation:
  First([Observation: "LdlCholesterol"] O
      where O.status in { 'final', 'amended', 'corrected' } and O.value is FHIR.Quantity and O.effective is not null
      sort by start of effective desc)

/** Extract SBP from a standalone systolic Observation or a BP-panel component (LOINC 8480-6). */
define LatestSbpObservation:
  First(
    [Observation] O
      where O.status in { 'final', 'amended', 'corrected' }
        and O.effective is not null
        and (
          ( O.code in "SystolicBloodPressure" and O.value is FHIR.Quantity )
            or exists (
              O.component C
                where C.code in "SystolicBloodPressure"
                  and C.value is FHIR.Quantity
            )
        )
      sort by start of effective desc
  )

define function SbpMmHgFromObservation(O Observation):
  if O is null then null
  else Coalesce(
    if O.code in "SystolicBloodPressure" and O.value is FHIR.Quantity
      then FHIRHelpers.ToQuantity(O.value as FHIR.Quantity).value
      else null,
    First(
      O.component C
        where C.code in "SystolicBloodPressure" and C.value is FHIR.Quantity
        return FHIRHelpers.ToQuantity(C.value as FHIR.Quantity).value
    )
  )

define LatestCreatinineObservation:
  First([Observation: "Creatinine"] O
      where O.status in { 'final', 'amended', 'corrected' } and O.value is FHIR.Quantity and O.effective is not null
      sort by start of effective desc)

define LatestTotalCholMgDl:
  case when LatestTotalCholObservation is not null then ObservationQuantityToMgDl(LatestTotalCholObservation.value as FHIR.Quantity) else null end

define LatestHdlMgDl:
  case when LatestHdlObservation is not null then ObservationQuantityToMgDl(LatestHdlObservation.value as FHIR.Quantity) else null end

define LatestLdlMgDl:
  case when LatestLdlObservation is not null then ObservationQuantityToMgDl(LatestLdlObservation.value as FHIR.Quantity) else null end

define LatestSbpMmHg:
  SbpMmHgFromObservation(LatestSbpObservation)

define LatestCreatinineMgDl:
  case when LatestCreatinineObservation is not null then ObservationQuantityToMgDl(LatestCreatinineObservation.value as FHIR.Quantity) else null end

define BestBmiKgM2:
  BMI.BestBmiKgM2

define IsFemale:
  Patient.gender ~ 'female'

define IsMale:
  Patient.gender ~ 'male'

define ActiveDiabetesMellitusType2Condition:
  First([Condition: "DiabetesMellitusType2"] C
      where exists ( C.clinicalStatus.coding CSCode where CSCode.code ~ 'active' ))

define HasDiabetesMellitusType2:
  ActiveDiabetesMellitusType2Condition is not null

define LatestSmokingObservation:
  First([Observation: "TobaccoSmokingStatus"] O
      where O.status in { 'final', 'amended', 'corrected' } and O.effective is not null
      sort by start of effective desc)

define CurrentSmokingFromObservation:
  case
    when LatestSmokingObservation is null then false
    when ( LatestSmokingObservation.value as FHIR.CodeableConcept ) in "CurrentSmokerAnswers" then true
    else false end

define function MedicationRequestDrugConcept(request FHIR.MedicationRequest):
  case
    when request.medication is FHIR.CodeableConcept then request.medication as FHIR.CodeableConcept
    when request.medication is FHIR.Reference then First([Medication] Med
        where Med.id = Last(Split((request.medication as FHIR.Reference).reference, '/'))
    ).code
    else null end

define ActiveStatinMedicationRequest:
  First([MedicationRequest] M
      where M.status in { 'active', 'on-hold' } and MedicationRequestDrugConcept(M) in "StatinTherapy"
      sort by authoredOn desc)

define ActiveStatinTherapy:
  ActiveStatinMedicationRequest is not null

define ActiveAntihypertensiveMedicationRequest:
  First([MedicationRequest] M
      where M.status in { 'active', 'on-hold' } and MedicationRequestDrugConcept(M) in "AntihypertensiveTherapy"
      sort by authoredOn desc)

define ActiveAntihypertensiveTherapy:
  ActiveAntihypertensiveMedicationRequest is not null

define ChartEgfrFromCreatinine:
  case
    when LatestCreatinineMgDl is null then null
    when not ( EffectiveIsFemale or EffectiveIsMale ) then null
    else Egfr2021Creatinine(LatestCreatinineMgDl, EffectiveAgeYears, EffectiveIsFemale) end

define EgfrFromCreatinine:
  ChartEgfrFromCreatinine

define EffectiveAgeYears:
  Coalesce(OverrideAgeYears, AgeInYears())

define EffectiveIsFemale:
  if OverrideIsFemale is not null then OverrideIsFemale else IsFemale

define EffectiveIsMale:
  if OverrideIsFemale is not null then not OverrideIsFemale else IsMale

define EffectiveTotalCholMgDl:
  Coalesce(OverrideTotalCholMgDl, LatestTotalCholMgDl)

define EffectiveHdlMgDl:
  Coalesce(OverrideHdlMgDl, LatestHdlMgDl)

define EffectiveSbpMmHg:
  Coalesce(OverrideSbpMmHg, LatestSbpMmHg)

define EffectiveBmiKgM2:
  Coalesce(OverrideBmiKgM2, BestBmiKgM2)

define EffectiveEgfr:
  Coalesce(OverrideEgfr, ChartEgfrFromCreatinine)

define EffectiveDiabetes:
  Coalesce(OverrideDiabetes, HasDiabetesMellitusType2)

define EffectiveCurrentSmoker:
  Coalesce(OverrideCurrentSmoker, CurrentSmokingFromObservation)

define EffectiveAntihypertensive:
  Coalesce(OverrideAntihypertensive, ActiveAntihypertensiveTherapy)

define EffectiveStatin:
  Coalesce(OverrideStatin, ActiveStatinTherapy)

define HasValidUacr:
  OverrideUacrMgG is not null and OverrideUacrMgG >= 0.1 and OverrideUacrMgG <= 25000.0

define HasValidHba1c:
  OverrideHba1cPercent is not null and OverrideHba1cPercent >= 3.0 and OverrideHba1cPercent <= 15.0

define HasValidSdi:
  OverrideSdiDecile is not null and OverrideSdiDecile >= 1 and OverrideSdiDecile <= 10

define OptionalValidCount:
  ( if HasValidUacr then 1 else 0 ) + ( if HasValidHba1c then 1 else 0 ) + ( if HasValidSdi then 1 else 0 )

define SelectedPreventModel:
  case
    when OptionalValidCount >= 2 then 'full'
    when HasValidUacr then 'uacr'
    when HasValidHba1c then 'hba1c'
    when HasValidSdi then 'sdi'
    else 'base' end

define InputsComplete:
  EffectiveAgeYears >= 30
    and EffectiveAgeYears <= 79
    and ( EffectiveIsFemale or EffectiveIsMale )
    and EffectiveTotalCholMgDl is not null
    and EffectiveHdlMgDl is not null
    and EffectiveSbpMmHg is not null
    and EffectiveBmiKgM2 is not null
    and EffectiveEgfr is not null

define EffectiveUacrOrZero:
  if HasValidUacr then OverrideUacrMgG else 1.0

define EffectiveHba1cOrZero:
  if HasValidHba1c then OverrideHba1cPercent else 5.3

define EffectiveSdiOrZero:
  if HasValidSdi then OverrideSdiDecile else 1


define PrepTerms10Selected:
  case
    when not InputsComplete then null
    when SelectedPreventModel = 'uacr' then PrepTerms10Uacr(EffectiveAgeYears, EffectiveTotalCholMgDl, EffectiveHdlMgDl, EffectiveSbpMmHg, EffectiveDiabetes, EffectiveCurrentSmoker, EffectiveBmiKgM2, EffectiveEgfr, EffectiveAntihypertensive, EffectiveStatin, OverrideUacrMgG)
    when SelectedPreventModel = 'hba1c' then PrepTerms10Hba1c(EffectiveAgeYears, EffectiveTotalCholMgDl, EffectiveHdlMgDl, EffectiveSbpMmHg, EffectiveDiabetes, EffectiveCurrentSmoker, EffectiveBmiKgM2, EffectiveEgfr, EffectiveAntihypertensive, EffectiveStatin, OverrideHba1cPercent)
    when SelectedPreventModel = 'sdi' then PrepTerms10Sdi(EffectiveAgeYears, EffectiveTotalCholMgDl, EffectiveHdlMgDl, EffectiveSbpMmHg, EffectiveDiabetes, EffectiveCurrentSmoker, EffectiveBmiKgM2, EffectiveEgfr, EffectiveAntihypertensive, EffectiveStatin, OverrideSdiDecile)
    when SelectedPreventModel = 'full' then PrepTerms10Full(EffectiveAgeYears, EffectiveTotalCholMgDl, EffectiveHdlMgDl, EffectiveSbpMmHg, EffectiveDiabetes, EffectiveCurrentSmoker, EffectiveBmiKgM2, EffectiveEgfr, EffectiveAntihypertensive, EffectiveStatin, EffectiveUacrOrZero, HasValidUacr, EffectiveHba1cOrZero, HasValidHba1c, EffectiveSdiOrZero, HasValidSdi)
    else PrepTerms10YrBase(EffectiveAgeYears, EffectiveTotalCholMgDl, EffectiveHdlMgDl, EffectiveSbpMmHg, EffectiveDiabetes, EffectiveCurrentSmoker, EffectiveBmiKgM2, EffectiveEgfr, EffectiveAntihypertensive, EffectiveStatin) end

define PrepTerms30Selected:
  case
    when not InputsComplete then null
    when SelectedPreventModel = 'uacr' then PrepTerms30Uacr(EffectiveAgeYears, EffectiveTotalCholMgDl, EffectiveHdlMgDl, EffectiveSbpMmHg, EffectiveDiabetes, EffectiveCurrentSmoker, EffectiveBmiKgM2, EffectiveEgfr, EffectiveAntihypertensive, EffectiveStatin, OverrideUacrMgG)
    when SelectedPreventModel = 'hba1c' then PrepTerms30Hba1c(EffectiveAgeYears, EffectiveTotalCholMgDl, EffectiveHdlMgDl, EffectiveSbpMmHg, EffectiveDiabetes, EffectiveCurrentSmoker, EffectiveBmiKgM2, EffectiveEgfr, EffectiveAntihypertensive, EffectiveStatin, OverrideHba1cPercent)
    when SelectedPreventModel = 'sdi' then PrepTerms30Sdi(EffectiveAgeYears, EffectiveTotalCholMgDl, EffectiveHdlMgDl, EffectiveSbpMmHg, EffectiveDiabetes, EffectiveCurrentSmoker, EffectiveBmiKgM2, EffectiveEgfr, EffectiveAntihypertensive, EffectiveStatin, OverrideSdiDecile)
    when SelectedPreventModel = 'full' then PrepTerms30Full(EffectiveAgeYears, EffectiveTotalCholMgDl, EffectiveHdlMgDl, EffectiveSbpMmHg, EffectiveDiabetes, EffectiveCurrentSmoker, EffectiveBmiKgM2, EffectiveEgfr, EffectiveAntihypertensive, EffectiveStatin, EffectiveUacrOrZero, HasValidUacr, EffectiveHba1cOrZero, HasValidHba1c, EffectiveSdiOrZero, HasValidSdi)
    else PrepTerms30YrBase(EffectiveAgeYears, EffectiveTotalCholMgDl, EffectiveHdlMgDl, EffectiveSbpMmHg, EffectiveDiabetes, EffectiveCurrentSmoker, EffectiveBmiKgM2, EffectiveEgfr, EffectiveAntihypertensive, EffectiveStatin) end

define TenYearTotalCvdProbability:
  case
    when not InputsComplete then null
    when SelectedPreventModel = 'base' and EffectiveIsMale then RiskFromBetasN(23, Beta10MaleTotalCvdBase, PrepTerms10Selected)
    when SelectedPreventModel = 'base' then RiskFromBetasN(23, Beta10FemaleTotalCvdBase, PrepTerms10Selected)
    when SelectedPreventModel = 'uacr' and EffectiveIsMale then RiskFromBetasN(25, Beta10MaleTotalCvdUacr, PrepTerms10Selected)
    when SelectedPreventModel = 'uacr' then RiskFromBetasN(25, Beta10FemaleTotalCvdUacr, PrepTerms10Selected)
    when SelectedPreventModel = 'hba1c' and EffectiveIsMale then RiskFromBetasN(26, Beta10MaleTotalCvdHba1c, PrepTerms10Selected)
    when SelectedPreventModel = 'hba1c' then RiskFromBetasN(26, Beta10FemaleTotalCvdHba1c, PrepTerms10Selected)
    when SelectedPreventModel = 'sdi' and EffectiveIsMale then RiskFromBetasN(26, Beta10MaleTotalCvdSdi, PrepTerms10Selected)
    when SelectedPreventModel = 'sdi' then RiskFromBetasN(26, Beta10FemaleTotalCvdSdi, PrepTerms10Selected)
    when SelectedPreventModel = 'full' and EffectiveIsMale then RiskFromBetasN(31, Beta10MaleTotalCvdFull, PrepTerms10Selected)
    when SelectedPreventModel = 'full' then RiskFromBetasN(31, Beta10FemaleTotalCvdFull, PrepTerms10Selected)
    else null end

define TenYearTotalCvdPercent:
  case when TenYearTotalCvdProbability is null then null else 100.0 * TenYearTotalCvdProbability end

define ThirtyYearTotalCvdProbability:
  case
    when not InputsComplete then null
    when SelectedPreventModel = 'base' and EffectiveIsMale then RiskFromBetasN(24, Beta30MaleTotalCvdBase, PrepTerms30Selected)
    when SelectedPreventModel = 'base' then RiskFromBetasN(24, Beta30FemaleTotalCvdBase, PrepTerms30Selected)
    when SelectedPreventModel = 'uacr' and EffectiveIsMale then RiskFromBetasN(26, Beta30MaleTotalCvdUacr, PrepTerms30Selected)
    when SelectedPreventModel = 'uacr' then RiskFromBetasN(26, Beta30FemaleTotalCvdUacr, PrepTerms30Selected)
    when SelectedPreventModel = 'hba1c' and EffectiveIsMale then RiskFromBetasN(27, Beta30MaleTotalCvdHba1c, PrepTerms30Selected)
    when SelectedPreventModel = 'hba1c' then RiskFromBetasN(27, Beta30FemaleTotalCvdHba1c, PrepTerms30Selected)
    when SelectedPreventModel = 'sdi' and EffectiveIsMale then RiskFromBetasN(27, Beta30MaleTotalCvdSdi, PrepTerms30Selected)
    when SelectedPreventModel = 'sdi' then RiskFromBetasN(27, Beta30FemaleTotalCvdSdi, PrepTerms30Selected)
    when SelectedPreventModel = 'full' and EffectiveIsMale then RiskFromBetasN(32, Beta30MaleTotalCvdFull, PrepTerms30Selected)
    when SelectedPreventModel = 'full' then RiskFromBetasN(32, Beta30FemaleTotalCvdFull, PrepTerms30Selected)
    else null end

define ThirtyYearTotalCvdPercent:
  case when ThirtyYearTotalCvdProbability is null then null else 100.0 * ThirtyYearTotalCvdProbability end

define TenYearAscvdProbability:
  case
    when not InputsComplete then null
    when SelectedPreventModel = 'base' and EffectiveIsMale then RiskFromBetasN(23, Beta10MaleAscvdBase, PrepTerms10Selected)
    when SelectedPreventModel = 'base' then RiskFromBetasN(23, Beta10FemaleAscvdBase, PrepTerms10Selected)
    when SelectedPreventModel = 'uacr' and EffectiveIsMale then RiskFromBetasN(25, Beta10MaleAscvdUacr, PrepTerms10Selected)
    when SelectedPreventModel = 'uacr' then RiskFromBetasN(25, Beta10FemaleAscvdUacr, PrepTerms10Selected)
    when SelectedPreventModel = 'hba1c' and EffectiveIsMale then RiskFromBetasN(26, Beta10MaleAscvdHba1c, PrepTerms10Selected)
    when SelectedPreventModel = 'hba1c' then RiskFromBetasN(26, Beta10FemaleAscvdHba1c, PrepTerms10Selected)
    when SelectedPreventModel = 'sdi' and EffectiveIsMale then RiskFromBetasN(26, Beta10MaleAscvdSdi, PrepTerms10Selected)
    when SelectedPreventModel = 'sdi' then RiskFromBetasN(26, Beta10FemaleAscvdSdi, PrepTerms10Selected)
    when SelectedPreventModel = 'full' and EffectiveIsMale then RiskFromBetasN(31, Beta10MaleAscvdFull, PrepTerms10Selected)
    when SelectedPreventModel = 'full' then RiskFromBetasN(31, Beta10FemaleAscvdFull, PrepTerms10Selected)
    else null end

define TenYearAscvdPercent:
  case when TenYearAscvdProbability is null then null else 100.0 * TenYearAscvdProbability end

define ThirtyYearAscvdProbability:
  case
    when not InputsComplete then null
    when SelectedPreventModel = 'base' and EffectiveIsMale then RiskFromBetasN(24, Beta30MaleAscvdBase, PrepTerms30Selected)
    when SelectedPreventModel = 'base' then RiskFromBetasN(24, Beta30FemaleAscvdBase, PrepTerms30Selected)
